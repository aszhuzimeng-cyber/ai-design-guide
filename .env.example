# DeepSeek API（复制为 .env 并填入真实 key，勿提交到 git）
DEEPSEEK_API_KEY=your_api_key_here

# 可选：网络环境需要代理/网关时覆盖 DeepSeek API 地址
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 页面 HTML 生成用强模型（与 VITE_DEEPSEEK_MODEL 一致时可只设下面一行）
VITE_DEEPSEEK_MODEL=deepseek-v4-pro

# 意图/机制/视觉 JSON 分析用便宜模型（务必保留，避免分析也走 v4-pro 烧钱）
VITE_DEEPSEEK_FAST_MODEL=deepseek-chat

# 可选：单独指定生成模型；不设则沿用 VITE_DEEPSEEK_MODEL
# VITE_DEEPSEEK_GENERATE_MODEL=deepseek-v4-pro

# 默认不会后台自动调 AI；确认要自动分析时再开启
# VITE_ENABLE_AUTO_AI=true

# 可选：每日 API 请求硬上限。默认不限制；仅在需要控费时设置数字，例如 48
# VITE_AI_DAILY_REQUEST_LIMIT=48

# 模块增删时是否调 AI 编排（默认关闭，本地规则处理）
# VITE_AI_ORCHESTRATE_MODULES=true

# Optional: module tag add/remove uses local layout by default.
# Set true only when each tag edit should call AI orchestration.
# VITE_AI_ORCHESTRATE_MODULES=true
