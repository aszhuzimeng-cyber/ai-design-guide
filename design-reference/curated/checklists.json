[
  {
    "id": "pre-recommendation",
    "type": "checklist",
    "title": "推荐前检查",
    "summary": "确保 AI 推荐不是模板匹配，而是基于用户输入和设计判断。",
    "items": [
      "是否识别了用户明确要求和反向偏好？",
      "是否判断了谁在看、要弄明白什么、凭什么相信？",
      "是否避免把行业当第一判断依据？",
      "三个方案是否真的不同？",
      "每个方案是否有短理由和风险？",
      "视觉方案是否具体到颜色、字体、布局和图片方式？",
      "是否避免品牌仿制？"
    ],
    "sourceRefs": [
      "internal/product-principles"
    ],
    "sourceTypes": [
      "internal-principle"
    ]
  },
